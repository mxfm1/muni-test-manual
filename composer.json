{
  "name": "manual-muni/manual-muni",
  "description": "Demo de manual de gestión con PHP y arquitectura MVC.",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "intervention/image": "^3.0",
    "symfony/validator": "^7.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "ManualMuni\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ManualMuni\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
